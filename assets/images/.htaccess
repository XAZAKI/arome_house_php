# Folder ini hanya untuk gambar. Jangan pernah jalankan skrip dari sini.
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
